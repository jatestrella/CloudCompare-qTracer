<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PipelineDialog</class>
 <widget class="QDialog" name="PipelineDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>440</width><height>720</height></rect>
  </property>
  <property name="windowTitle">
   <string>qTracer — Fracture Extraction Pipeline</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="infoLabel">
     <property name="text">
      <string>Runs the full pipeline in one go:
Eigenvector Computing → Cylindrical DBSCAN Clustering → Lineation → Trace Clustering → Plane Fitting → Coplanar Plane Merging.
Intermediate and final groups are added to the DB tree.</string>
     </property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="stageColumns">
     <item>
      <layout class="QVBoxLayout" name="leftColumn">

   <!-- Stage 1 : Eigenvector Computing -->
   <item>
    <widget class="QGroupBox" name="eigenGroup">
     <property name="title"><string>1. Eigenvector Computing</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QFormLayout" name="eigenForm">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Kernel radius (r_k)</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="kernelRadiusSpinBox">
        <property name="toolTip"><string>Radius of the spherical kernel used to build the local covariance matrix A = XᵀX.
Outputs per point: eigenvalues λ₁ ≥ λ₂ ≥ λ₃, principal eigenvector v₁, and linearity L = (λ₁ − λ₂) / λ₁.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.100000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="autoScaleCheckBox">
        <property name="text"><string>Auto scale (per-point optimal radius)</string></property>
        <property name="toolTip"><string>When on, stage 1 evaluates PCA linearity at several radii per point and keeps, for each point, the radius that maximises linearity. Fills the same PC Linearity / MaxEigVec SFs (plus an OptScale field) so stages 2+ are unchanged. The fixed kernel radius above is then ignored.</string></property>
        <property name="checked"><bool>false</bool></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Auto: min radius (r_min)</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="autoScaleRMinSpinBox">
        <property name="toolTip"><string>Smallest candidate radius. Keep it well above the point spacing (enough points for a stable PCA).</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.020000000000000</double></property>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Auto: max radius (r_max)</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="autoScaleRMaxSpinBox">
        <property name="toolTip"><string>Largest candidate radius. The per-point search runs over [r_min, r_max].</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.200000000000000</double></property>
       </widget>
      </item>
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Auto: steps</string></property></widget></item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="autoScaleStepsSpinBox">
        <property name="toolTip"><string>How many radii to test, evenly spaced in [r_min, r_max] (inclusive). Cost scales with this.</string></property>
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>50</number></property>
        <property name="value"><number>5</number></property>
       </widget>
      </item>
      <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Auto: min neighbours</string></property></widget></item>
      <item row="5" column="1">
       <widget class="QSpinBox" name="autoScaleMinPtsSpinBox">
        <property name="toolTip"><string>A radius is only considered for a point if its neighbourhood holds at least this many points — guards against tiny-scale noise that would otherwise look spuriously linear.</string></property>
        <property name="minimum"><number>3</number></property>
        <property name="maximum"><number>100000</number></property>
        <property name="value"><number>15</number></property>
       </widget>
      </item>
      <item row="6" column="0"><widget class="QLabel"><property name="text"><string>Auto: criterion</string></property></widget></item>
      <item row="6" column="1">
       <widget class="QComboBox" name="autoScaleCriterionComboBox">
        <property name="toolTip"><string>How each point's best radius is chosen. Min eigenentropy = the scale where the local structure is least ambiguous (principled, recommended). Max linearity = simpler but biases toward small scales.</string></property>
        <item><property name="text"><string>Min eigenentropy (recommended)</string></property></item>
        <item><property name="text"><string>Max linearity</string></property></item>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="eigenCloneNote">
        <property name="text"><string>Stage 1 runs on a clone named "&lt;cloud&gt; [eigen features]"; the original cloud is never modified.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Stage 2 : Cylindrical DBSCAN Clustering -->
   <item>
    <widget class="QGroupBox" name="dbscanGroup">
     <property name="title"><string>2. Cylindrical DBSCAN Clustering</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QFormLayout" name="dbscanForm">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Search radius (R)</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="dbscanRadiusSpinBox">
        <property name="toolTip"><string>DBSCAN search radius R. Also the radius of the cylindrical neighbourhood.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.030000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Minimum points (minPts)</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="dbscanMinPointsSpinBox">
        <property name="toolTip"><string>Minimum number of neighbours inside the search volume for a point to become a core point.</string></property>
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>1000000</number></property>
        <property name="value"><number>50</number></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Max eigenvector angle θ_db (deg)</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="dbscanMaxAngleSpinBox">
        <property name="toolTip"><string>Max angle θ_db between the principal eigenvector v₁ of a candidate core point and that of the cluster seed point.</string></property>
        <property name="decimals"><number>2</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>90.000000000000000</double></property>
        <property name="singleStep"><double>1.000000000000000</double></property>
        <property name="value"><double>15.000000000000000</double></property>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Linearity threshold (L)</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="dbscanLinearitySpinBox">
        <property name="toolTip"><string>Pre-filter on the linearity index L = (λ₁ − λ₂) / λ₁ from stage 1.
Only points with L above this value are passed to the clustering.</string></property>
        <property name="decimals"><number>3</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>1.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.900000000000000</double></property>
       </widget>
      </item>
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Search neighbourhood</string></property></widget></item>
      <item row="4" column="1">
       <widget class="QComboBox" name="dbscanSearchTypeComboBox">
        <property name="toolTip"><string>Cylinder: axis along the principal eigenvector v₁, radius R, half-length h = 2R (total length 4R).
Sphere: classical DBSCAN neighbourhood of radius R.</string></property>
        <item><property name="text"><string>Cylinder (along v₁, h = 2R)</string></property></item>
        <item><property name="text"><string>Sphere (classical)</string></property></item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Stage 3 : Lineation -->
   <item>
    <widget class="QGroupBox" name="tracesGroup">
     <property name="title"><string>3. Lineation</string></property>
     <property name="toolTip"><string>Simplifies each cluster into one straight segment: midpoint = cluster centroid, direction = v₁, endpoints = the extreme projections of the cluster points onto v₁.</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QVBoxLayout" name="tracesLayout">
      <item>
       <widget class="QCheckBox" name="randomColorsCheckBox">
        <property name="text"><string>Random colors (else: color by dip / dip direction)</string></property>
        <property name="checked"><bool>false</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

      <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      </layout>
     </item>
     <item>
      <layout class="QVBoxLayout" name="rightColumn">

   <!-- Stage 4 : Trace Clustering -->
   <item>
    <widget class="QGroupBox" name="clusteringGroup">
     <property name="title"><string>4. Trace Clustering</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QFormLayout" name="clusteringForm">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Collinearity radius (r_c)</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="coneRadiusSpinBox">
        <property name="toolTip"><string>Radius of the cylinder around a trace's infinite line.
Two pieces are collinear when each has an end point inside the other's cylinder.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.100000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Max gap (g_max)</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="twoTraceDistSpinBox">
        <property name="toolTip"><string>Largest end-to-end gap that may still be bridged between two trace pieces.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.500000000000000</double></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Max direction deviation Δθ_max (deg)</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="clusterMinAngleSpinBox">
        <property name="toolTip"><string>Two pieces are merged only when their directions differ by at most this angle.
Note: this is an upper bound (θ ≤ Δθ_max) — the opposite sense of the threshold angle in stage 5.</string></property>
        <property name="decimals"><number>2</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>90.000000000000000</double></property>
        <property name="singleStep"><double>1.000000000000000</double></property>
        <property name="value"><double>20.000000000000000</double></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Stage 5 : Plane Fitting -->
   <item>
    <widget class="QGroupBox" name="planeGroup">
     <property name="title"><string>5. Plane Fitting</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QFormLayout" name="planeForm">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Threshold distance (d_th)</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="planeIntersectionDistSpinBox">
        <property name="toolTip"><string>Max shortest distance d_ij between the two trace lines (common-perpendicular distance).
Pairs with d_ij ≥ d_th are treated as parallel or as not belonging to the same joint plane.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.100000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Threshold length (L_th)</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="planeMinTraceLenSpinBox">
        <property name="toolTip"><string>Both traces of a pair must be longer than L_th, to avoid misjudgment caused by small traces.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.010000000000000</double></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Threshold angle θ_th (deg)</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="planeMinAngleSpinBox">
        <property name="toolTip"><string>The angle θ_ij = arccos(|u_i · u_j|) between the two traces must exceed θ_th,
so that two near-parallel traces are not fitted into a joint plane.</string></property>
        <property name="decimals"><number>2</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>90.000000000000000</double></property>
        <property name="singleStep"><double>1.000000000000000</double></property>
        <property name="value"><double>30.000000000000000</double></property>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Max end-point distance (e_th)</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="planeMaxEndPointDistSpinBox">
        <property name="toolTip"><string>At least one of the four cross end-point distances (P_i-P_j, P_i-Q_j, Q_i-P_j, Q_i-Q_j) must be below this value,
so that the two traces are also close in space, not merely coplanar as infinite lines.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.200000000000000</double></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Stage 6 : Coplanar Plane Merging -->
   <item>
    <widget class="QGroupBox" name="mergeGroup">
     <property name="title"><string>6. Coplanar Plane Merging</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>true</bool></property>
     <layout class="QFormLayout" name="mergeForm">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Max normal angle α_max (deg)</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="mergeMaxNormalAngleSpinBox">
        <property name="toolTip"><string>Coplanarity test |N_i · N_j| ≥ cos α_max.
Two facets whose normals differ by more than α_max will NOT be merged.</string></property>
        <property name="decimals"><number>2</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>90.000000000000000</double></property>
        <property name="singleStep"><double>1.000000000000000</double></property>
        <property name="value"><double>10.000000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Max plane offset (δ_max)</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="mergeMaxPlaneDistSpinBox">
        <property name="toolTip"><string>Coplanarity test |(c_j − c_i) · N_i| ≤ δ_max.
Max perpendicular offset of a candidate centroid from the seed plane.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000100000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.050000000000000</double></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Max centroid distance</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="mergeMaxCentroidDistSpinBox">
        <property name="toolTip"><string>Max centroid-to-centroid distance for two facets to be merged — an in-plane proximity limit that stops coplanar-but-laterally-distant facets being merged across a large gap. 0 = no limit.</string></property>
        <property name="decimals"><number>4</number></property>
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>10000.000000000000000</double></property>
        <property name="singleStep"><double>0.010000000000000</double></property>
        <property name="value"><double>0.000000000000000</double></property>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Max passes</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="mergeMaxPassesSpinBox">
        <property name="toolTip"><string>How many times to re-run the merge on its own output. Stops early if the plane count stops decreasing.</string></property>
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>100</number></property>
        <property name="value"><number>10</number></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QCheckBox" name="mergeDropUnmergedCheckBox">
        <property name="text"><string>Drop unmerged planes (keep only consolidated)</string></property>
        <property name="toolTip"><string>Remove joint planes that were never merged with any other (i.e. that still represent a single stage-5 plane). Keeps only genuinely consolidated planes in the output.</string></property>
        <property name="checked"><bool>false</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

      <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      </layout>
     </item>
    </layout>
   </item>

   <item>
    <layout class="QHBoxLayout" name="paramIoLayout">
     <item><widget class="QPushButton" name="importParamsButton"><property name="text"><string>Import params…</string></property><property name="toolTip"><string>Load all pipeline parameters and stage selections from a text file.</string></property></widget></item>
     <item><widget class="QPushButton" name="exportParamsButton"><property name="text"><string>Export params…</string></property><property name="toolTip"><string>Save all current pipeline parameters and stage selections to a text file.</string></property></widget></item>
     <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
    </layout>
   </item>

   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
    </widget>
   </item>
  </layout>
 </widget>
 <connections>
  <connection>
   <sender>buttonBox</sender><signal>accepted()</signal>
   <receiver>PipelineDialog</receiver><slot>accept()</slot>
   <hints><hint type="sourcelabel"><x>0</x><y>0</y></hint><hint type="destinationlabel"><x>0</x><y>0</y></hint></hints>
  </connection>
  <connection>
   <sender>buttonBox</sender><signal>rejected()</signal>
   <receiver>PipelineDialog</receiver><slot>reject()</slot>
   <hints><hint type="sourcelabel"><x>0</x><y>0</y></hint><hint type="destinationlabel"><x>0</x><y>0</y></hint></hints>
  </connection>
 </connections>
</ui>
